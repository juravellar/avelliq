# Copie para .env e preencha. O README ("Rodando localmente") explica cada variável.
# Nunca coloque valores reais neste arquivo: ele vai para o repositório público.
# Deixe vazia a variável que você não for usar: o sistema trata qualquer valor
# como configurado, então um exemplo preenchido liga a integração com dados inválidos.

# Banco e autenticação (obrigatórias)
# Formato: postgres://usuario:senha@localhost:5432/avelliq
DATABASE_URL=
# Gere com: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Login com Google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Stripe (use as chaves do modo de testes)
# sk_test_...
STRIPE_SECRET_KEY=
# whsec_... (mostrado pelo stripe listen)
STRIPE_WEBHOOK_SECRET=
# price_...
STRIPE_ESSENTIAL_PLAN_PRICE_ID=
STRIPE_PROFESSIONAL_PLAN_PRICE_ID=
# Preços anuais (opcionais)
STRIPE_ESSENTIAL_ANNUAL_PRICE_ID=
STRIPE_PROFESSIONAL_ANNUAL_PRICE_ID=
NEXT_PUBLIC_STRIPE_CUSTOMER_PORTAL_URL=

# Envio de emails pelo Resend (opcional). Com as duas, a conta só é liberada
# depois de confirmar o email.
RESEND_API_KEY=
# Formato: Avelliq <nao-responda@seu-dominio.com.br>
EMAIL_FROM=
# Leitura dos emails recebidos na tela de Atendimento (opcional, Full access)
RESEND_RECEIVING_API_KEY=

# Suporte e equipe
# E-mail do domínio mostrado nos documentos legais, por exemplo contato@seu-dominio.com.br
SUPPORT_EMAIL=
# Caixa do "Falar com a equipe" (opcional; sem ela, vai para SUPPORT_EMAIL)
SUPPORT_INBOX=
# Contas principais do Avelliq, separadas por vírgula (opcional)
SUPPORT_ADMIN_EMAILS=

# CNPJ mostrado nos documentos legais (opcional)
LEGAL_CNPJ=

# Limpeza diária pelo Vercel Cron
CRON_SECRET=

# Testes de integração contra um PostgreSQL de teste (opcional)
INTEGRATION_DATABASE_URL=
